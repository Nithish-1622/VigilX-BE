      "name": "1. Authentication & Session Management",
      "item": [
        {
          "name": "Login (Get JWT Tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates against PostgreSQL user accounts and sets collection variables `authToken` & `refreshToken`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"officer1\",\n  \"password\": \"Officer123!\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.access);",
                  "    console.log(\"Saved authToken to collection variables.\");",
                  "}",
                  "if (jsonData.refresh) {",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refresh);",
                  "    console.log(\"Saved refreshToken to collection variables.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
